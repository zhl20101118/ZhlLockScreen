# ------------------------------- 密码管理器 -------------------------------
class PasswordManager:
    PASSWORD_FILE = PASSWORD_FILE
    SALT = b"lockscreen_secure_salt"

    @classmethod
    def _hash(cls, pwd):
        h = hashlib.sha256()
        h.update(cls.SALT)
        h.update(pwd.encode('utf-8'))
        return h.hexdigest()

    @classmethod
    def initialize(cls):
        if not os.path.exists(cls.PASSWORD_FILE):
            cls.save_password("123456")
            print("初始密码已设为 123456")

    @classmethod
    def save_password(cls, new_pwd):
        with open(cls.PASSWORD_FILE, "w") as f:
            f.write(cls._hash(new_pwd))

    @classmethod
    def verify(cls, pwd):
        if not os.path.exists(cls.PASSWORD_FILE):
            cls.initialize()
        try:
            with open(cls.PASSWORD_FILE, "r") as f:
                stored = f.read().strip()
            return stored == cls._hash(pwd)
        except:
            return False

# ------------------------------- 设置管理器 -------------------------------
class SettingsManager:
    SETTINGS_FILE = SETTINGS_FILE

    @classmethod
    def load(cls):
        if os.path.exists(cls.SETTINGS_FILE):
            try:
                with open(cls.SETTINGS_FILE, 'r', encoding='utf-8') as f:
                    return json.load(f)
            except:
                pass
        return {
            "wallpaper": "",
            "show_time": False,
            "transparent_bg": False,
            "theme": "auto",
            "hotkey": "ctrl+alt+l",
            "enable_face_recognition": False,
            "opacity": 0.96
        }

    @classmethod
    def save(cls, settings):
        with open(cls.SETTINGS_FILE, 'w', encoding='utf-8') as f:
            json.dump(settings, f, indent=4, ensure_ascii=False)

# ------------------------------- 快捷键管理器（修复版：自动恢复 + 异步回调）------------------------------
class HotkeyManager:
    def __init__(self, callback):
        self.callback = callback
        self.current_hotkey = None
        self.listening = False
        self._lock = threading.Lock()
        self._health_thread = None
        self._stop_health = threading.Event()
        self._last_trigger = 0  # 最后触发时间戳，用于健康检查

    def _safe_callback(self):
        """在独立线程中执行回调，避免阻塞钩子线程"""
        self._last_trigger = time.time()
        # 启动新线程执行用户回调（启动锁屏等）
        threading.Thread(target=self.callback, daemon=True).start()

    def start(self, hotkey_str):
        with self._lock:
            if self.listening:
                self.stop()
            try:
                # 移除可能存在的旧钩子
                keyboard.unhook_all()
                # 注册新热键，回调使用安全包装
                keyboard.add_hotkey(hotkey_str, self._safe_callback)
                self.current_hotkey = hotkey_str
                self.listening = True
                logging.info(f"快捷键 {hotkey_str} 已注册")
                # 启动健康检查线程
                self._start_health_check()
            except Exception as e:
                logging.error(f"注册快捷键失败: {e}")
                self.listening = False
                raise

    def stop(self):
        with self._lock:
            if not self.listening:
                return
            self._stop_health.set()
            if self._health_thread and self._health_thread.is_alive():
                self._health_thread.join(timeout=1)
            try:
                keyboard.unhook_all()
                logging.info(f"快捷键 {self.current_hotkey} 已移除")
            except Exception as e:
                logging.warning(f"移除快捷键时出错: {e}")
            self.listening = False
            self.current_hotkey = None
            self._last_trigger = 0

    def change_hotkey(self, new_hotkey):
        self.stop()
        self.start(new_hotkey)

    def _start_health_check(self):
        """启动健康检查线程，定期验证热键是否有效"""
        if self._health_thread and self._health_thread.is_alive():
            self._stop_health.set()
            self._health_thread.join(timeout=0.5)
        self._stop_health.clear()
        self._health_thread = threading.Thread(target=self._health_loop, daemon=True)
        self._health_thread.start()

    def _health_loop(self):
        """每隔10秒检查热键是否工作，若长时间未触发则尝试重新注册"""
        CHECK_INTERVAL = 10      # 检查间隔（秒）
        INACTIVE_TIMEOUT = 60    # 超过60秒无任何触发则认为可能失效
        while not self._stop_health.wait(CHECK_INTERVAL):
            if not self.listening:
                break
            now = time.time()
            # 如果从未触发过，或者距离上次触发超过 INACTIVE_TIMEOUT
            if self._last_trigger == 0 or (now - self._last_trigger) > INACTIVE_TIMEOUT:
                logging.warning("热键可能失效，尝试重新注册...")
                with self._lock:
                    if not self.listening:
                        break
                    hotkey = self.current_hotkey
                    if hotkey:
                        try:
                            keyboard.unhook_all()
                            keyboard.add_hotkey(hotkey, self._safe_callback)
                            logging.info(f"热键 {hotkey} 已重新注册")
                        except Exception as e:
                            logging.error(f"重新注册失败: {e}")

